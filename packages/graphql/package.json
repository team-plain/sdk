{
  "name": "@team-plain/graphql",
  "version": "4.0.0",
  "description": "Typed TypeScript SDK for Plain's GraphQL API with auto-generated model classes",
  "license": "MIT",
  "author": "Plain <hello@plain.com> (https://plain.com)",
  "homepage": "https://github.com/team-plain/sdk/tree/main/packages/graphql#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/team-plain/sdk.git",
    "directory": "packages/graphql"
  },
  "bugs": {
    "url": "https://github.com/team-plain/sdk/issues"
  },
  "keywords": [
    "plain",
    "graphql",
    "sdk",
    "typescript",
    "api",
    "customer-support"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-documents": "node src/generate-documents.ts",
    "download-schema": "node scripts/download-schema.ts",
    "update-schema": "node scripts/update-schema.ts",
    "codegen": "node src/generate-documents.ts && graphql-codegen --config codegen.yml",
    "build": "tsc && tsdown && node scripts/drop-generated-sourcemaps.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.4",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2 || ^17.0.2"
  },
  "devDependencies": {
    "@changesets/types": "^7.0.0",
    "@changesets/write": "^1.0.1",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/plugin-helpers": "^7.4.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@graphql-codegen/visitor-plugin-common": "^7.2.7",
    "@graphql-inspector/core": "^8.0.0",
    "@team-plain/graphql-codegen-plugin": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}
