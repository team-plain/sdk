{
  "autoReview": ["open", "push"],
  "autoApprove": {
    "enabled": true,
    "riskCeiling": "low",
    "filters": {
      "includePaths": ["**/*.md", ".changeset/*.md", "packages/*/src/**"],
      "excludePaths": [
        "**/.greptile/**",
        ".github/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".nvmrc",
        "**/package.json",
        ".changeset/config.json",
        "**/CHANGELOG.md"
      ]
    }
  }
}
